<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Toute l'app est Windows-only (hosts, taskkill, WinRT/SMTC...) -
         pas de raison de garder Umbra.Core portable multi-OS. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contrôle du volume par application (session WASAPI de Spotify.exe) -
         GSMTC n'expose pas de volume, seul le mixeur audio Windows (Core
         Audio API) le permet. NAudio.Wasapi encapsule cette API COM. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbra.Tests" />
  </ItemGroup>

</Project>
