<UserControl x:Class="Umbra.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsRootPanel" MaxWidth="1000">
            <TextBlock x:Name="FocusSessionsHeaderText" FontWeight="Bold" Margin="0,0,0,8" />

            <ui:CardExpander x:Name="PresetsExpander" Margin="0,0,0,6">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Timer24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock x:Name="PeriodsTitleText" />
                        <TextBlock x:Name="PeriodsDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel MinWidth="400">
                    <StackPanel x:Name="PresetsPanel" Orientation="Horizontal" Margin="0,0,0,10" />
                    <DockPanel>
                        <ui:Button x:Name="AddPresetButton" DockPanel.Dock="Right" Appearance="Secondary" Margin="8,0,0,0" Click="AddPreset_Click" />
                        <ui:TextBox x:Name="NewPresetBox" PlaceholderText="45" />
                    </DockPanel>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander x:Name="ClockStyleExpander" Margin="0,0,0,6">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Clock24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock x:Name="ClockStyleTitleText" />
                        <TextBlock x:Name="ClockStyleDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <WrapPanel x:Name="ClockStylePanel" MinWidth="400" />
            </ui:CardExpander>

            <ui:CardExpander x:Name="FloatingFocusExpander" Margin="0,0,0,6"
                             Expanded="FloatingFocusExpander_Expanded">
                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="WindowNew24" /></ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock x:Name="FloatingFocusTitleText" />
                        <TextBlock x:Name="FloatingFocusDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel MinWidth="400">
                    <TextBlock x:Name="FloatingFocusCurrentText" FontSize="12" Opacity="0.6" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FloatingFocusPresetsLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ItemsControl x:Name="FloatingFocusPresetsList" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <TextBlock x:Name="FloatingFocusRecentLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ItemsControl x:Name="FloatingFocusRecentList" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:Button x:Name="FloatingFocusBrowseButton" Appearance="Secondary" Margin="0,0,8,0" Click="FloatingFocusBrowse_Click" />
                        <ui:Button x:Name="FloatingFocusClearButton" Appearance="Secondary" Click="FloatingFocusClear_Click" />
                    </StackPanel>
                    <TextBlock x:Name="FloatingFocusBlurLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <Slider x:Name="FloatingFocusBlurSlider" Minimum="0" Maximum="35" Width="260" HorizontalAlignment="Left" ValueChanged="FloatingFocusBlurSlider_ValueChanged" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Alert24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="SoundSessionTitleText" />
                        <TextBlock x:Name="SoundSessionDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SoundSessionToggle" Checked="SoundSessionToggle_Changed" Unchecked="SoundSessionToggle_Changed" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Alert24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="SoundBreakTitleText" />
                        <TextBlock x:Name="SoundBreakDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SoundBreakToggle" Checked="SoundBreakToggle_Changed" Unchecked="SoundBreakToggle_Changed" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="MusicNote224" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="SpotifyTitleText" />
                        <TextBlock x:Name="SpotifyDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SpotifyToggle" Checked="SpotifyToggle_Changed" Unchecked="SpotifyToggle_Changed" />
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,20">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Alert24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock x:Name="SmartReminderTitleText" />
                        <TextBlock x:Name="SmartReminderDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel MinWidth="400">
                    <ComboBox x:Name="SmartReminderModeBox" Width="220" HorizontalAlignment="Left" SelectionChanged="SmartReminderModeBox_SelectionChanged">
                        <ComboBoxItem x:Name="SmartReminderOffItem" Tag="off" />
                        <ComboBoxItem x:Name="SmartReminderManualItem" Tag="manual" />
                        <ComboBoxItem x:Name="SmartReminderAutomaticItem" Tag="automatic" />
                    </ComboBox>
                    <StackPanel x:Name="SmartReminderTimePanel" Margin="0,12,0,0">
                        <TextBlock x:Name="SmartReminderTimeLabelText" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="SmartReminderTimeBox" Width="120" HorizontalAlignment="Left" LostFocus="SmartReminderTimeBox_LostFocus" />
                    </StackPanel>
                    <TextBlock x:Name="SmartReminderAutomaticHintText" Visibility="Collapsed" FontSize="12" Opacity="0.6" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardExpander>

            <TextBlock x:Name="GeneralHeaderText" FontWeight="Bold" Margin="0,0,0,8" />

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="LocalLanguage24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock x:Name="LanguageLabelText" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageBox" Width="140" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="Français" Tag="fr" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl x:Name="ThemeSettingsCard" Tag="theme thème appearance apparence dark sombre light clair" Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="WeatherMoon24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="ThemeTitleText" />
                        <TextBlock x:Name="ThemeDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" Width="140" SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem x:Name="ThemeDarkItem" Tag="Dark" />
                    <ComboBoxItem x:Name="ThemeLightItem" Tag="Light" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Tag="layout disposition interface background fond sidebar barre latérale" Margin="0,0,0,6">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="PanelLeft24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="BackgroundModeLabelText" />
                        <TextBlock x:Name="BackgroundModeDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="BackgroundModeBox" Width="320" SelectionChanged="BackgroundModeBox_SelectionChanged">
                    <ComboBoxItem x:Name="BackgroundModeFullItem" Tag="full" />
                    <ComboBoxItem x:Name="BackgroundModeContentItem" Tag="content" />
                    <ComboBoxItem x:Name="BackgroundModeNavigationItem" Tag="navigation" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardExpander x:Name="BackgroundExpander" Margin="0,0,0,6"
                             Expanded="BackgroundExpander_Expanded">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Color24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock x:Name="BackgroundTitleText" VerticalAlignment="Center" />
                </ui:CardExpander.Header>
                <StackPanel MinWidth="400">
                    <TextBlock x:Name="BackgroundCurrentText" FontSize="12" Opacity="0.6" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DefaultBackgroundsLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ItemsControl x:Name="DefaultBackgroundsList" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="RecentBackgroundsLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ItemsControl x:Name="RecentBackgroundsList" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button x:Name="BrowseBackgroundButton" Appearance="Secondary" Margin="0,0,8,0" Click="BrowseBackground_Click" />
                        <ui:Button x:Name="ClearBackgroundButton" Appearance="Secondary" Click="ClearBackground_Click" />
                    </StackPanel>
                    <TextBlock x:Name="BackgroundBlurLabelText" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <Slider x:Name="BackgroundBlurSlider" Minimum="0" Maximum="100" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14" ValueChanged="BackgroundBlurSlider_ValueChanged" />
                    <TextBlock x:Name="BackgroundOpacityLabelText" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" Width="260" HorizontalAlignment="Left"
                            ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Power24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="StartupLabelText" />
                        <TextBlock x:Name="StartupStatusText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupToggle" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" />
            </ui:CardControl>

            <ui:CardControl Tag="update updates updater version mise a jour installer redemarrer" Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitleText" />
                        <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="UpdateProgressBar" Width="110" Height="4" Margin="0,0,12,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <ui:Button x:Name="UpdateButton" Appearance="Secondary" Click="UpdateButton_Click" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Tag="logs crash diagnostic journaux erreur support" Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="DiagnosticLogsTitleText" />
                        <TextBlock x:Name="DiagnosticLogsDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="DiagnosticLogsButton" Appearance="Secondary" Click="DiagnosticLogsButton_Click" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="AlertUrgent24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="NotificationsTitleText" />
                        <TextBlock x:Name="NotificationsDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="NotificationsLinkButton" Appearance="Transparent" Click="NotificationsLink_Click">
                    <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                </ui:Button>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Globe24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="BrowserExtensionTitleText" />
                        <TextBlock x:Name="BrowserExtensionStatusText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="520" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="BrowserExtensionInstallButton" Appearance="Secondary" Click="BrowserExtensionInstall_Click" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Shield24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="PrivacyTitleText" />
                        <TextBlock x:Name="PrivacyDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="500" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="ClearHistoryButton" Appearance="Secondary" Click="ClearHistory_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
