<UserControl x:Class="Umbra.App.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Arrondi de cards plus prononcé, demandé pour cet onglet
             uniquement - posé ici (pas dans App.xaml) pour ne pas affecter
             Réglages. ui:Card n'expose pas de CornerRadius stylable
             directement, il suit cette ressource partagée du thème. -->
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

        <!-- Petits titres de section en gras + bleu accent, comme sur Focus/
             Blocages. -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="StreakNumberText" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F7A21B" />
                        <TextBlock x:Name="StreakLabelText" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <StackPanel x:Name="WeekdayRow" Orientation="Horizontal" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StreakRecordText" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="StreakDescText" FontSize="11" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Center">
                    <UniformGrid x:Name="SummaryGrid" Columns="3" Rows="2" Margin="22,18" />
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,0,0,8">
                <StackPanel Margin="18">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Cursor="Hand" Click="MusicHeader_Click" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="MusicHeaderText" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="MusicTotalText" FontSize="11" Opacity="0.55" Margin="0,3,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <Path x:Name="MusicExpandGlyph" Data="M 1,2 L 5,6 L 9,2" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="7" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.65" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="MusicEmptyPanel" HorizontalAlignment="Center" Margin="0,20,0,20">
                        <ui:SymbolIcon Symbol="Headphones24" FontSize="56" Opacity="0.35" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock x:Name="MusicEmptyText" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                    </StackPanel>
                    <ItemsControl x:Name="MusicList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" Rows="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="AllMusicList" Visibility="Collapsed" Opacity="0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel Margin="18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <ComboBox x:Name="ActivityYearBox" Width="100" Margin="0,0,8,0" SelectionChanged="ActivityFilter_SelectionChanged" />
                        <ComboBox x:Name="ActivityMonthBox" Width="150" SelectionChanged="ActivityFilter_SelectionChanged" />
                    </StackPanel>
                    <Grid x:Name="ActivityHeatmapGrid" Height="126" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="ActivityLegendText" FontSize="11" Opacity="0.55" Margin="0,10,0,0" />
                </StackPanel>
            </ui:Card>

            <TextBlock x:Name="BlockedHeaderText" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <ui:Card Margin="0,0,0,8">
                <StackPanel Margin="18">
                    <TextBlock x:Name="BlockedSummaryText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl x:Name="BlockedAttemptsList" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
