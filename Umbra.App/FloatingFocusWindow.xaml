<ui:FluentWindow x:Class="Umbra.App.FloatingFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="500" Height="430" MinWidth="390" MinHeight="340"
        Background="#1A1A1A" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" WindowCornerPreference="Default"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
        <Grid ClipToBounds="True" Background="#1A1A1A">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
            <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" IsMuted="True" MediaEnded="BackgroundVideo_MediaEnded" />
            <Border Background="#7A101010" />
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="34"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="PhaseText" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" Margin="38,5" TextTrimming="CharacterEllipsis" />
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Width="30" Height="30" Padding="5" Background="Transparent" BorderThickness="0" Foreground="White" Click="Close_Click"><ui:SymbolIcon Symbol="Dismiss24" FontSize="14" /></Button>
                </Grid>
                <Grid x:Name="RingHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="ModeDetailText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="5" Margin="0,0,9,0"><Image x:Name="SpotifyThumbnail" Stretch="UniformToFill" /></Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="210">
                            <TextBlock x:Name="SpotifyTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SpotifyArtist" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
</ui:FluentWindow>
