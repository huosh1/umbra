<UserControl x:Class="Umbra.App.NowPlayingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="64">
    <!-- Barre "lecture en cours" façon Ambie (bandeau fin juste sous la
         barre de titre, avec transport play/pause) - pilote Spotify via les
         Global System Media Transport Controls de Windows (SpotifyControl
         dans Umbra.Core), pas d'API/compte Spotify nécessaire.

         Comme il n'y a plus de barre de titre séparée (voir MainWindow.xaml),
         c'est ce bandeau qui sert de zone de glisser-déposer/boutons système.
         WindowChrome.CaptionHeight (MainWindow.xaml) ne suffit pas ici : sur
         ui:FluentWindow avec ExtendsContentIntoTitleBar=True, WPF-UI gère
         apparemment son propre WindowChrome en interne et écrase/ignore le
         nôtre - vérifié empiriquement (clic-glissé sur une zone vide du
         bandeau ne bougeait pas la fenêtre malgré IsHitTestVisibleInChrome
         correctement posé sur les boutons). Le bandeau appelle donc
         Window.DragMove() lui-même sur MouseLeftButtonDown (zone vide
         uniquement : Button/Slider marquent l'évènement Handled avant qu'il
         ne remonte jusqu'ici), ce qui marche indépendamment de WindowChrome. -->
    <UserControl.Resources>
        <!-- Bouton icône seule, sans "box" (pas de fond/bordure au repos,
             comme demandé) - ui:Button (WPF-UI) a son propre template Fluent2
             avec un fond visible même en Appearance=Transparent, donc on
             repart d'un Button WPF nu entièrement retemplaté plutôt que
             d'essayer de neutraliser le template de ui:Button. -->
        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6" />
            <!-- Un Style avec x:Key n'hérite d'aucun Setter du style Button
                 implicite de ui:ControlsDictionary (App.xaml) - sans ce
                 Foreground explicite, le Button (et donc le SymbolIcon qu'il
                 contient, qui hérite de son Foreground) retombe sur le noir
                 par défaut de WPF, invisible sur fond sombre. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" x:Name="TransportPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="PlayPauseButton" Style="{StaticResource IconOnlyButtonStyle}" Click="PlayPause_Click">
                    <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Play24" FontSize="18" Filled="True" />
                </Button>
                <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="10,0,0,0"
                        PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                        ValueChanged="VolumeSlider_ValueChanged" />
            </StackPanel>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Margin="12,0" ClipToBounds="True" shell:WindowChrome.IsHitTestVisibleInChrome="True" PreviewMouseLeftButtonDown="MediaArea_PreviewMouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="TrackInfoPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ThumbnailBorder" Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0" Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="ThumbnailBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <ui:SymbolIcon x:Name="FallbackIcon" Symbol="MusicNote224" FontSize="14" Opacity="0.5" Margin="0,0,8,0" />
                <TextBlock x:Name="TrackTitleText" FontSize="13" FontWeight="SemiBold" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="TrackArtistText" FontSize="13" Opacity="0.6" MaxWidth="100" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="AmbientSoundsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource IconOnlyButtonStyle}" Width="44" Padding="0" Click="Minimize_Click">
                    <ui:SymbolIcon Symbol="Subtract24" FontSize="14" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource IconOnlyButtonStyle}" Width="44" Padding="0" Click="Maximize_Click">
                    <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Square24" FontSize="13" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource IconOnlyButtonStyle}" Width="44" Padding="0" Click="Close_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
